{
  "name": "@deepseek-ai/dsh-client-ui-files",
  "version": "1.0.0",
  "private": true,
  "description": "Files view tab for Web: a directory/file navigation pane plus a syntax-highlighted file viewer for the current workspace",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
