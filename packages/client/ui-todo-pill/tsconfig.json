{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "lib/types",
    "noEmit": true,
    "types": []
  },
  "include": ["src"]
}
